<% customer_attribute = lambda do |customer, attribute, default = nil|
  if customer.respond_to?(attribute)
    customer.public_send(attribute)
  elsif customer.respond_to?(:[])
    customer[attribute] || customer[attribute.to_s] || default
  else
    default
  end
end %>

<% order_attribute = lambda do |order, attribute, default = nil|
  if order.respond_to?(attribute)
    order.public_send(attribute)
  elsif order.respond_to?(:[])
    order[attribute] || order[attribute.to_s] || default
  else
    default
  end
end %>

<% activity_attribute = lambda do |activity, attribute, default = nil|
  if activity.respond_to?(attribute)
    activity.public_send(attribute)
  elsif activity.respond_to?(:[])
    activity[attribute] || activity[attribute.to_s] || default
  else
    default
  end
end %>

<% preview_customer = customers_preview ? preview_customers.find { |customer| customer[:id].to_s == params[:id].to_s } : nil %>
<% customer_record = if defined?(@customer) && @customer.present?
  @customer
else
  preview_customer
end %>

<% customers_back_path = customers_preview ? admin_customers_path(preview: preview_mode) : admin_customers_path %>

<% if customer_record.present? %>
  <% customer_id = customer_attribute.call(customer_record, :id, params[:id]) %>

  <% name = customer_attribute.call(customer_record, :name, nil).presence ||
    customer_attribute.call(customer_record, :full_name, nil).presence ||
    [
      customer_attribute.call(customer_record, :first_name, nil),
      customer_attribute.call(customer_record, :last_name, nil)
    ].compact.join(" ").presence ||
    "Cliente sin nombre" %>

  <% email = customer_attribute.call(customer_record, :email, nil) %>
  <% phone = customer_attribute.call(customer_record, :phone, nil) %>
  <% address = customer_attribute.call(customer_record, :address, nil) %>
  <% segment = customer_attribute.call(customer_record, :segment, "Sin segmento") %>
  <% status = customer_attribute.call(customer_record, :status, "active").to_s %>
  <% orders_count = customer_attribute.call(customer_record, :orders_count, 0).to_i %>
  <% total_spent = customer_attribute.call(customer_record, :total_spent, 0).to_f %>
  <% receivable_amount = customer_attribute.call(customer_record, :receivable_amount, 0).to_f %>
  <% receivable_since = customer_attribute.call(customer_record, :receivable_since, nil) %>
  <% last_order_date = customer_attribute.call(customer_record, :last_order_date, nil) %>
  <% notes = customer_attribute.call(customer_record, :notes, nil) %>

  <% customer_orders = if defined?(@orders) && @orders.present?
    @orders.to_a
  elsif customer_record.respond_to?(:orders)
    customer_record.orders.to_a
  elsif customers_preview
    preview_orders_by_customer[customer_id.to_s] || []
  else
    []
  end %>

  <% customer_activities = if defined?(@activities) && @activities.present?
    @activities.to_a
  elsif customers_preview
    preview_activities_by_customer[customer_id.to_s] || []
  else
    []
  end %>

  <% has_email = email.present? %>
  <% has_phone = phone.present? %>
  <% phone_href = has_phone ? phone.to_s.gsub(/[^\d+]/, "") : nil %>

  <% formatted_last_order_date = if last_order_date.present? && last_order_date.respond_to?(:strftime)
    last_order_date.strftime("%d/%m/%Y")
  elsif last_order_date.present?
    last_order_date.to_s
  else
    "Sin pedidos"
  end %>

  <% formatted_receivable_since = if receivable_since.present? && receivable_since.respond_to?(:strftime)
    receivable_since.strftime("%d/%m/%Y")
  elsif receivable_since.present?
    receivable_since.to_s
  else
    nil
  end %>

  <% receivable_overdue = receivable_since.present? &&
    receivable_since.respond_to?(:to_date) &&
    receivable_since.to_date < Date.current - 30.days %>

  <% average_order_value = orders_count.positive? ? total_spent / orders_count : 0 %>

  <% status_label = case status
  when "active"
    "Activo"
  when "pending_order"
    "Pedido pendiente"
  when "new"
    "Nuevo"
  when "inactive"
    "Inactivo"
  else
    status.to_s.humanize
  end %>

  <% status_classes = case status
  when "active"
    "border-unel-crema-2 bg-white text-unel-verde"
  when "pending_order"
    "border-amber-200 bg-amber-50 text-amber-700"
  when "new"
    "border-unel-crema-2 bg-unel-crema text-unel-carbon"
  when "inactive"
    "border-unel-crema-2 bg-white text-unel-humo"
  else
    "border-unel-crema-2 bg-unel-crema text-unel-humo"
  end %>

  <% recommended_action = if receivable_amount.positive? && receivable_overdue
