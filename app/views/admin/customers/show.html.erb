      title: "Cobrar deuda vencida",
      description: "Este cliente tiene una cuenta por cobrar vencida. Conviene contactarlo y revisar el historial de pedidos.",
      tone: "danger"
    }
  elsif receivable_amount.positive?
    {
      title: "Revisar cuenta por cobrar",
      description: "Existe un saldo pendiente. Revisa si corresponde enviar recordatorio o confirmar fecha de pago.",
      tone: "warning"
    }
  elsif status == "pending_order"
    {
      title: "Confirmar pedido pendiente",
      description: "Hay un pedido que requiere seguimiento antes de continuar el flujo de venta.",
      tone: "warning"
    }
  elsif status == "inactive"
    {
      title: "Reactivar cliente",
      description: "Este cliente no registra compras recientes. Puede ser candidato para campaña o contacto directo.",
      tone: "muted"
    }
  elsif status == "new"
    {
      title: "Acompañar primera experiencia",
      description: "Cliente nuevo. Conviene revisar que la primera compra haya sido clara y bien atendida.",
      tone: "neutral"
    }
  else
    {
      title: "Cliente al día",
      description: "No hay acciones urgentes. Mantén seguimiento normal y revisa oportunidades de venta.",
      tone: "success"
    }
  end %>

  <% action_box_classes = case recommended_action[:tone]
  when "danger"
    "border-red-200 bg-red-50"
  when "warning"
    "border-amber-200 bg-amber-50"
  when "success"
    "border-unel-crema-2 bg-white"
  else
    "border-unel-crema-2 bg-unel-blanco"
  end %>

  <% action_label_classes = case recommended_action[:tone]
  when "danger"
    "text-red-700"
  when "warning"
    "text-amber-700"
  else
    "text-unel-dorado"
  end %>

  <% orders_path = customers_preview ? admin_orders_path(customer_id: customer_id, preview: preview_mode) : admin_orders_path(customer_id: customer_id) %>

  <section>
    <div class="mb-8 flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
      <div>
        <div class="mb-3">
          <%= link_to "← Volver a clientes", customers_back_path,
            class: "text-sm font-semibold text-unel-humo transition hover:text-unel-dorado" %>
        </div>

        <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-unel-dorado">
          Ficha comercial
        </p>

        <div class="flex flex-col gap-4 lg:flex-row lg:items-center">
          <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-3xl bg-unel-verde text-2xl font-bold text-white">
            <%= name.first.to_s.upcase %>
          </div>

          <div>
            <div class="flex flex-wrap items-center gap-3">
              <h1 class="text-2xl font-bold text-unel-carbon md:text-3xl">
                <%= name %>
              </h1>

              <span class="inline-flex rounded-full border px-3 py-1 text-xs font-semibold <%= status_classes %>">
                <%= status_label %>
              </span>
            </div>

            <p class="mt-2 text-sm font-semibold uppercase tracking-wide text-unel-dorado">
              <%= segment.presence || "Sin segmento" %>
            </p>

            <p class="mt-1 max-w-2xl text-sm text-unel-humo">
              Revisa el contexto del cliente, su historial comercial, saldos pendientes y próximas acciones recomendadas.
            </p>
          </div>
        </div>
      </div>

      <div class="grid w-full gap-2 sm:grid-cols-3 lg:w-auto">
        <% if has_email %>
          <%= link_to "Email", "mailto:#{email}",
            class: "inline-flex justify-center rounded-xl border border-unel-crema-2 bg-white px-4 py-2 text-sm font-semibold text-unel-humo transition hover:border-unel-dorado hover:text-unel-dorado" %>
        <% else %>
          <span class="inline-flex justify-center rounded-xl border border-unel-crema-2 bg-white px-4 py-2 text-sm font-semibold text-unel-humo opacity-50">
            Email
          </span>
        <% end %>

        <% if has_phone %>
          <%= link_to "Llamar", "tel:#{phone_href}",
            class: "inline-flex justify-center rounded-xl border border-unel-crema-2 bg-white px-4 py-2 text-sm font-semibold text-unel-humo transition hover:border-unel-dorado hover:text-unel-dorado" %>
        <% else %>
          <span class="inline-flex justify-center rounded-xl border border-unel-crema-2 bg-white px-4 py-2 text-sm font-semibold text-unel-humo opacity-50">
            Llamar
          </span>
        <% end %>

        <%= link_to "Ver pedidos", orders_path,
          class: "inline-flex justify-center rounded-xl bg-unel-verde px-4 py-2 text-sm font-semibold text-white transition hover:bg-unel-carbon" %>
      </div>
    </div>

    <div class="grid gap-5 xl:grid-cols-[minmax(0,1.35fr)_minmax(20rem,0.65fr)]">
      <div class="space-y-5">
        <div class="rounded-3xl border border-unel-crema-2 bg-white p-5 shadow-sm sm:p-6">
          <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
            <div class="rounded-2xl bg-unel-crema px-4 py-3">
              <p class="text-xs font-semibold uppercase tracking-wide text-unel-humo">
                Total comprado
              </p>

              <p class="mt-1 text-2xl font-bold text-unel-dorado">
                <%= number_to_currency(total_spent, unit: "$", precision: 0, delimiter: ".") %>
              </p>
            </div>

            <div class="rounded-2xl bg-unel-crema px-4 py-3">
              <p class="text-xs font-semibold uppercase tracking-wide text-unel-humo">
                Pedidos
              </p>

              <p class="mt-1 text-2xl font-bold text-unel-carbon">
                <%= orders_count %>
              </p>
            </div>

            <div class="rounded-2xl bg-unel-crema px-4 py-3">
              <p class="text-xs font-semibold uppercase tracking-wide text-unel-humo">
                Ticket promedio
              </p>

              <p class="mt-1 text-2xl font-bold text-unel-carbon">
                <%= number_to_currency(average_order_value, unit: "$", precision: 0, delimiter: ".") %>
              </p>
            </div>

            <div class="rounded-2xl border <%= receivable_amount.positive? ? (receivable_overdue ? "border-red-200 bg-red-50" : "border-amber-200 bg-amber-50") : "border-unel-crema-2 bg-unel-blanco" %> px-4 py-3">
              <p class="text-xs font-semibold uppercase tracking-wide <%= receivable_amount.positive? ? (receivable_overdue ? "text-red-700" : "text-amber-700") : "text-unel-humo" %>">
                Por cobrar
              </p>

              <p class="mt-1 text-2xl font-bold <%= receivable_amount.positive? ? (receivable_overdue ? "text-red-700" : "text-amber-700") : "text-unel-carbon" %>">
                <%= receivable_amount.positive? ? number_to_currency(receivable_amount, unit: "$", precision: 0, delimiter: ".") : "$0" %>
              </p>
            </div>
          </div>
        </div>

        <div class="rounded-3xl border <%= action_box_classes %> p-5 shadow-sm sm:p-6">
          <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
            <div>
              <p class="text-sm font-semibold uppercase tracking-wide <%= action_label_classes %>">
                Siguiente acción recomendada
              </p>

              <h2 class="mt-2 text-xl font-bold text-unel-carbon">
                <%= recommended_action[:title] %>
              </h2>

              <p class="mt-2 max-w-2xl text-sm leading-relaxed text-unel-humo">
                <%= recommended_action[:description] %>
              </p>
            </div>

            <div class="grid w-full gap-2 sm:grid-cols-2 lg:w-72">
              <% if has_phone %>
                <%= link_to "Contactar", "tel:#{phone_href}",
                  class: "inline-flex justify-center rounded-xl bg-unel-verde px-4 py-2 text-sm font-semibold text-white transition hover:bg-unel-carbon" %>
              <% else %>
                <span class="inline-flex justify-center rounded-xl bg-unel-verde px-4 py-2 text-sm font-semibold text-white opacity-50">
                  Contactar
                </span>
              <% end %>

              <%= link_to "Ver pedidos", orders_path,
                class: "inline-flex justify-center rounded-xl border border-unel-crema-2 bg-white px-4 py-2 text-sm font-semibold text-unel-humo transition hover:border-unel-dorado hover:text-unel-dorado" %>
            </div>
          </div>
        </div>

        <div class="rounded-3xl border border-unel-crema-2 bg-white shadow-sm">
          <div class="border-b border-unel-crema-2 px-5 py-4 sm:px-6">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <h2 class="text-lg font-bold text-unel-carbon">
                  Pedidos recientes
                </h2>

                <p class="mt-1 text-sm text-unel-humo">
                  Últimos movimientos comerciales asociados al cliente.
                </p>
              </div>

              <%= link_to "Ver todos", orders_path,
                class: "inline-flex w-fit rounded-xl border border-unel-crema-2 px-4 py-2 text-sm font-semibold text-unel-humo transition hover:border-unel-dorado hover:text-unel-dorado" %>
            </div>
          </div>

          <% if customer_orders.any? %>
            <div class="divide-y divide-unel-crema-2">
              <% customer_orders.first(5).each do |order| %>
                <% order_id = order_attribute.call(order, :id, nil) %>
                <% code = order_attribute.call(order, :code, "Pedido ##{order_id}") %>
                <% date = order_attribute.call(order, :date, nil) %>
                <% order_status = order_attribute.call(order, :status, "pending").to_s %>
                <% payment_status = order_attribute.call(order, :payment_status, "pending").to_s %>
                <% items_count = order_attribute.call(order, :items_count, 0).to_i %>
                <% total_amount = order_attribute.call(order, :total_amount, 0).to_f %>
                <% paid_amount = order_attribute.call(order, :paid_amount, 0).to_f %>
                <% pending_amount = [total_amount - paid_amount, 0].max %>

                <% formatted_order_date = if date.present? && date.respond_to?(:strftime)
                  date.strftime("%d/%m/%Y")
                elsif date.present?
                  date.to_s
                else
                  "Sin fecha"
                end %>

                <% order_status_label = case order_status
                when "delivered"
                  "Entregado"
                when "pending_confirmation"
                  "Por confirmar"
                when "in_production"
                  "En producción"
                when "cancelled"
                  "Cancelado"
                else
                  order_status.humanize
                end %>

                <% payment_status_label = case payment_status
                when "paid"
                  "Pagado"
                when "partial"
                  "Pago parcial"
                when "overdue"
                  "Pago vencido"
                else
                  "Pendiente"
                end %>

                <% payment_classes = case payment_status
                when "paid"
                  "border-unel-crema-2 bg-white text-unel-verde"
                when "partial"
                  "border-amber-200 bg-amber-50 text-amber-700"
                when "overdue"
                  "border-red-200 bg-red-50 text-red-700"
                else
                  "border-unel-crema-2 bg-unel-crema text-unel-humo"
                end %>

                <div class="px-5 py-4 sm:px-6">
                  <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_12rem_12rem] lg:items-center">
                    <div>
                      <div class="flex flex-wrap items-center gap-2">
                        <p class="font-bold text-unel-carbon">
                          <%= code %>
                        </p>

                        <span class="inline-flex rounded-full border border-unel-crema-2 bg-unel-blanco px-3 py-1 text-xs font-semibold text-unel-humo">
                          <%= order_status_label %>
                        </span>

                        <span class="inline-flex rounded-full border px-3 py-1 text-xs font-semibold <%= payment_classes %>">
                          <%= payment_status_label %>
                        </span>
                      </div>

                      <p class="mt-1 text-sm text-unel-humo">
                        <%= formatted_order_date %> · <%= items_count %> productos
                      </p>
                    </div>

                    <div>
                      <p class="text-xs font-semibold uppercase tracking-wide text-unel-humo">
                        Total
                      </p>

                      <p class="mt-1 text-sm font-bold text-unel-carbon">
                        <%= number_to_currency(total_amount, unit: "$", precision: 0, delimiter: ".") %>
                      </p>
                    </div>

                    <div>
                      <p class="text-xs font-semibold uppercase tracking-wide <%= pending_amount.positive? ? "text-amber-700" : "text-unel-humo" %>">
                        Pendiente
                      </p>

                      <p class="mt-1 text-sm font-bold <%= pending_amount.positive? ? "text-amber-700" : "text-unel-carbon" %>">
                        <%= number_to_currency(pending_amount, unit: "$", precision: 0, delimiter: ".") %>
                      </p>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="px-5 py-10 text-center sm:px-6">
              <p class="font-bold text-unel-carbon">
                Sin pedidos registrados
              </p>

              <p class="mt-1 text-sm text-unel-humo">
                Cuando existan ventas asociadas, aparecerán en esta ficha.
              </p>
            </div>
          <% end %>
        </div>
      </div>

      <aside class="space-y-5">
        <div class="rounded-3xl border border-unel-crema-2 bg-white p-5 shadow-sm">
          <h2 class="text-lg font-bold text-unel-carbon">
            Información del cliente
          </h2>

          <div class="mt-4 space-y-3">
            <div class="rounded-2xl bg-unel-crema px-4 py-3">
              <p class="text-xs font-semibold uppercase tracking-wide text-unel-humo">
                Email
              </p>

              <p class="mt-1 break-words text-sm font-bold text-unel-carbon">
                <%= email.presence || "Sin email registrado" %>
              </p>
            </div>

            <div class="rounded-2xl bg-unel-crema px-4 py-3">
              <p class="text-xs font-semibold uppercase tracking-wide text-unel-humo">
                Teléfono
              </p>

              <p class="mt-1 text-sm font-bold text-unel-carbon">
                <%= phone.presence || "Sin teléfono registrado" %>
              </p>
            </div>

            <div class="rounded-2xl bg-unel-crema px-4 py-3">
              <p class="text-xs font-semibold uppercase tracking-wide text-unel-humo">
                Dirección
              </p>

              <p class="mt-1 text-sm font-bold text-unel-carbon">
                <%= address.presence || "Sin dirección registrada" %>
              </p>
            </div>
          </div>
        </div>

        <div class="rounded-3xl border <%= receivable_amount.positive? ? (receivable_overdue ? "border-red-200 bg-red-50" : "border-amber-200 bg-amber-50") : "border-unel-crema-2 bg-white" %> p-5 shadow-sm">
          <p class="text-sm font-semibold uppercase tracking-wide <%= receivable_amount.positive? ? (receivable_overdue ? "text-red-700" : "text-amber-700") : "text-unel-dorado" %>">
            Cuenta por cobrar
          </p>

          <p class="mt-2 text-2xl font-bold <%= receivable_amount.positive? ? (receivable_overdue ? "text-red-700" : "text-amber-700") : "text-unel-carbon" %>">
            <%= receivable_amount.positive? ? number_to_currency(receivable_amount, unit: "$", precision: 0, delimiter: ".") : "Sin deuda" %>
          </p>

          <% if receivable_amount.positive? && formatted_receivable_since.present? %>
            <p class="mt-2 text-sm <%= receivable_overdue ? "text-red-600" : "text-amber-700" %>">
              Desde <%= formatted_receivable_since %><%= receivable_overdue ? " · vencida" : "" %>
            </p>
          <% else %>
            <p class="mt-2 text-sm text-unel-humo">
              Cliente sin saldo pendiente registrado.
            </p>
          <% end %>
        </div>

        <div class="rounded-3xl border border-unel-crema-2 bg-white p-5 shadow-sm">
          <h2 class="text-lg font-bold text-unel-carbon">
            Notas internas
          </h2>

          <p class="mt-3 text-sm leading-relaxed text-unel-humo">
            <%= notes.presence || "Sin notas internas registradas para este cliente." %>
          </p>
        </div>

        <div class="rounded-3xl border border-unel-crema-2 bg-white p-5 shadow-sm">
          <h2 class="text-lg font-bold text-unel-carbon">
            Actividad reciente
          </h2>

          <% if customer_activities.any? %>
            <div class="mt-4 space-y-3">
              <% customer_activities.first(5).each do |activity| %>
                <% activity_date = activity_attribute.call(activity, :date, nil) %>
                <% activity_title = activity_attribute.call(activity, :title, "Actividad") %>
                <% activity_description = activity_attribute.call(activity, :description, nil) %>

                <% formatted_activity_date = if activity_date.present? && activity_date.respond_to?(:strftime)
                  activity_date.strftime("%d/%m/%Y")
                elsif activity_date.present?
                  activity_date.to_s
                else
                  "Sin fecha"
                end %>

                <div class="rounded-2xl bg-unel-crema px-4 py-3">
                  <p class="text-xs font-semibold text-unel-humo">
                    <%= formatted_activity_date %>
                  </p>

                  <p class="mt-1 text-sm font-bold text-unel-carbon">
                    <%= activity_title %>
                  </p>

                  <% if activity_description.present? %>
                    <p class="mt-1 text-xs leading-relaxed text-unel-humo">
                      <%= activity_description %>
                    </p>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="mt-3 text-sm text-unel-humo">
              Todavía no hay actividad registrada.
            </p>
          <% end %>
        </div>
      </aside>
    </div>
  </section>
<% else %>
  <section>
    <div class="rounded-3xl border border-unel-crema-2 bg-white px-5 py-14 text-center shadow-sm sm:px-6">
      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-unel-crema text-lg font-bold text-unel-verde">
        C
      </div>

      <h1 class="mt-4 text-2xl font-bold text-unel-carbon">
        Cliente no encontrado
      </h1>

      <p class="mx-auto mt-2 max-w-md text-sm text-unel-humo">
        No encontramos información para este cliente. Vuelve a la cartera para revisar los clientes disponibles.
      </p>

      <%= link_to "Volver a clientes", customers_back_path,
        class: "mt-6 inline-flex rounded-xl bg-unel-verde px-4 py-2 text-sm font-semibold text-white transition hover:bg-unel-carbon" %>
    </div>
  </section>
<% end %>