<% content_for :admin_section_key, "inventory" %>
<% content_for :admin_section_inner, "Inventario" %>
<% content_for :admin_search_placeholder, "Buscar inventario..." %>
<% content_for :admin_search_path, admin_inventory_movements_path %>

<% products = (@products || []).to_a %>
<% movement_new_path_available = respond_to?(:new_admin_inventory_movement_path) %>
<% default_low_stock_threshold = 5 %>
<% product_low_stock_threshold = lambda do |product|
  if product.respond_to?(:low_stock_threshold) && product.low_stock_threshold.present?
    product.low_stock_threshold.to_i
  else
    default_low_stock_threshold
  end
end %>

<% total_stock = products.sum { |product| product.stock.to_i } %>
<% inventory_value = products.sum { |product| product.stock.to_i * product.calculated_cost.to_f } %>
<% out_of_stock_products = products.select { |product| product.stock.to_i <= 0 } %>
<% low_stock_products = products.select { |product| product.stock.to_i.positive? && product.stock.to_i <= product_low_stock_threshold.call(product) } %>
<% critical_products = (out_of_stock_products + low_stock_products).uniq %>
<% available_products = products.count { |product| product.stock.to_i > product_low_stock_threshold.call(product) } %>

<section>
  <div class="mb-8 flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-unel-carbon md:text-3xl">
        Inventario
      </h1>

      <p class="mt-2 max-w-2xl text-sm text-unel-humo">
        Gestiona entradas, salidas y ajustes de stock sin tener que navegar por varias secciones.
      </p>
    </div>

    <%= link_to "Ver productos", admin_products_path,
      class: "rounded-xl border border-unel-crema-2 px-4 py-2 text-center text-sm font-semibold text-unel-humo transition hover:border-unel-dorado hover:text-unel-dorado" %>
  </div>

  <div class="grid gap-5 xl:grid-cols-[1.7fr_0.9fr]">
    <div class="rounded-2xl border border-unel-crema-2 bg-white p-5 shadow-sm">
      <div class="flex flex-col gap-2">
        <p class="text-sm font-semibold uppercase tracking-wide text-unel-dorado">
          Acciones rápidas
        </p>

        <h2 class="text-xl font-bold text-unel-carbon">
          ¿Qué quieres registrar?
        </h2>

        <p class="max-w-2xl text-sm text-unel-humo">
          Actualiza el stock de un producto terminado de forma directa.
        </p>
      </div>

      <div class="mt-5 grid gap-3 md:grid-cols-3">
        <% if movement_new_path_available %>
          <%= link_to new_admin_inventory_movement_path(movement_type: "entry"),
            class: "group rounded-xl border border-unel-crema-2 bg-unel-crema p-4 transition hover:border-unel-verde hover:bg-white hover:shadow-sm" do %>
            <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-unel-verde text-xl font-bold text-white">
              +
            </div>

            <h3 class="mt-3 text-base font-bold text-unel-carbon">
              Entrada de stock
            </h3>

            <p class="mt-1 text-sm text-unel-humo">
              Registra nuevas unidades disponibles.
            </p>

            <p class="mt-3 text-sm font-semibold text-unel-verde transition group-hover:text-unel-carbon">
              Registrar entrada →
            </p>
          <% end %>

          <%= link_to new_admin_inventory_movement_path(movement_type: "exit"),
            class: "group rounded-xl border border-red-100 bg-red-50 p-4 transition hover:border-red-200 hover:bg-white hover:shadow-sm" do %>
            <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-red-500 text-xl font-bold text-white">
              −
            </div>

            <h3 class="mt-3 text-base font-bold text-unel-carbon">
              Salida de stock
            </h3>

            <p class="mt-1 text-sm text-unel-humo">
              Registra ventas, retiros o mermas.
            </p>

            <p class="mt-3 text-sm font-semibold text-red-600 transition group-hover:text-unel-carbon">
              Registrar salida →
            </p>
          <% end %>

          <%= link_to new_admin_inventory_movement_path(movement_type: "adjustment"),
            class: "group rounded-xl border border-amber-100 bg-amber-50 p-4 transition hover:border-amber-200 hover:bg-white hover:shadow-sm" do %>
            <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-unel-dorado text-xl font-bold text-white">
              ±
            </div>

            <h3 class="mt-3 text-base font-bold text-unel-carbon">
              Ajuste manual
            </h3>

            <p class="mt-1 text-sm text-unel-humo">
              Corrige stock según conteo físico.
            </p>

            <p class="mt-3 text-sm font-semibold text-unel-dorado transition group-hover:text-unel-carbon">
              Ajustar stock →
            </p>
          <% end %>
        <% else %>
          <%= link_to admin_products_path,
            class: "group rounded-xl border border-unel-crema-2 bg-unel-crema p-4 transition hover:border-unel-verde hover:bg-white hover:shadow-sm md:col-span-3" do %>
            <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-unel-verde text-xl font-bold text-white">
              →
            </div>

            <h3 class="mt-3 text-base font-bold text-unel-carbon">
              Editar stock desde productos
            </h3>

            <p class="mt-1 text-sm text-unel-humo">
              La creación de movimientos todavía no está conectada. Por ahora puedes actualizar stock desde productos.
            </p>

            <p class="mt-3 text-sm font-semibold text-unel-verde transition group-hover:text-unel-carbon">
              Ir a productos →
            </p>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="rounded-2xl border border-unel-crema-2 bg-white p-5 shadow-sm">
      <p class="text-sm font-semibold uppercase tracking-wide text-unel-dorado">
        Resumen actual
      </p>

      <h2 class="mt-2 text-xl font-bold text-unel-carbon">
        Estado del stock
      </h2>

      <div class="mt-5 grid grid-cols-2 gap-3">
        <div class="rounded-xl border border-unel-crema-2 bg-unel-blanco px-4 py-3">
          <p class="text-xs font-semibold uppercase tracking-wide text-unel-humo">
            Stock total
          </p>

          <p class="mt-1 text-xl font-bold text-unel-carbon">
            <%= total_stock %>
          </p>

          <p class="text-xs text-unel-humo">
            unidades disponibles
          </p>
        </div>

        <div class="rounded-xl border border-unel-crema-2 bg-unel-blanco px-4 py-3">
          <p class="text-xs font-semibold uppercase tracking-wide text-unel-humo">
            Valor inventario
          </p>

          <p class="mt-1 text-xl font-bold text-unel-verde">
            <%= number_to_currency(inventory_value, unit: "$", precision: 0, delimiter: ".") %>
          </p>

          <p class="text-xs text-unel-humo">
            costo acumulado
          </p>
        </div>

        <div class="rounded-xl border border-red-100 bg-red-50 px-4 py-3">
          <p class="text-xs font-semibold uppercase tracking-wide text-red-500">
            Agotados
          </p>

          <p class="mt-1 text-xl font-bold text-red-700">
            <%= out_of_stock_products.count %>
          </p>

          <p class="text-xs text-red-600">
            sin stock
          </p>
        </div>

        <div class="rounded-xl border border-amber-100 bg-amber-50 px-4 py-3">
          <p class="text-xs font-semibold uppercase tracking-wide text-amber-600">
            Stock bajo
          </p>

          <p class="mt-1 text-xl font-bold text-amber-700">
            <%= low_stock_products.count %>
          </p>

          <p class="text-xs text-amber-700">
            por reponer
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-6 rounded-2xl border border-unel-crema-2 bg-white shadow-sm">
    <div class="flex flex-col gap-3 border-b border-unel-crema-2 px-4 py-4 sm:px-6 lg:flex-row lg:items-center lg:justify-between">
      <div>
        <h2 class="text-lg font-bold text-unel-carbon">
          Requieren atención
        </h2>

        <p class="mt-1 text-sm text-unel-humo">
          Productos agotados o con stock bajo. Esta es la lista que conviene revisar primero.
        </p>
      </div>

      <span class="inline-flex w-fit rounded-full border border-unel-crema-2 bg-unel-crema px-3 py-1 text-xs font-semibold text-unel-humo">
        Umbral definido por producto
      </span>
    </div>

    <% if critical_products.any? %>
      <div class="space-y-3 p-4 sm:p-6">
        <% critical_products.first(6).each do |product| %>
          <% stock = product.stock.to_i %>
          <% product_threshold = product_low_stock_threshold.call(product) %>

          <% if stock <= 0 %>
            <% status_label = "Agotado" %>
            <% status_classes = "border-red-200 bg-red-50 text-red-700" %>
            <% helper_text = "Sin stock disponible" %>
          <% elsif stock <= product_threshold %>
            <% status_label = "Stock bajo" %>
            <% status_classes = "border-amber-200 bg-amber-50 text-amber-700" %>
            <% helper_text = "Conviene reponer pronto" %>
          <% end %>

          <div class="rounded-xl border border-unel-crema-2 bg-unel-blanco p-4">
            <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
              <div class="flex items-start gap-3">
                <% if product.image.attached? %>
                  <%= image_tag product.image, class: "h-12 w-12 rounded-lg border border-unel-crema-2 object-cover" %>
                <% else %>
                  <div class="flex h-12 w-12 items-center justify-center rounded-lg border border-unel-crema-2 bg-unel-crema text-center text-xs leading-tight text-unel-humo">
                    Sin foto
                  </div>
                <% end %>

                <div>
                  <div class="flex flex-wrap items-center gap-2">
                    <%= link_to product.name, admin_product_path(product),
                      class: "font-bold text-unel-carbon transition hover:text-unel-dorado" %>

                    <span class="inline-flex rounded-full border px-2.5 py-1 text-xs font-semibold <%= status_classes %>">
                      <%= status_label %>
                    </span>
                  </div>

                  <p class="mt-1 text-sm text-unel-humo">
                    <%= stock %> unidades · <%= helper_text %>
                  </p>
                  <p class="mt-1 text-xs text-unel-humo">
                    Umbral de este producto: <%= product_threshold %> unidades
                  </p>
                </div>
              </div>

              <div class="flex flex-wrap gap-2">
                <% if movement_new_path_available %>
                  <%= link_to "Registrar entrada", new_admin_inventory_movement_path(movement_type: "entry", product_id: product.id),
                    class: "rounded-xl bg-unel-verde px-4 py-2 text-sm font-semibold text-white transition hover:bg-unel-carbon" %>
                <% else %>
                  <%= link_to "Editar stock", edit_admin_product_path(product),
                    class: "rounded-xl bg-unel-verde px-4 py-2 text-sm font-semibold text-white transition hover:bg-unel-carbon" %>
                <% end %>

                <%= link_to "Ver producto", admin_product_path(product),
                  class: "rounded-xl border border-unel-crema-2 px-4 py-2 text-sm font-semibold text-unel-humo transition hover:border-unel-dorado hover:text-unel-dorado" %>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <% if critical_products.count > 6 %>
        <div class="border-t border-unel-crema-2 px-4 py-4 text-center sm:px-6">
          <p class="text-sm text-unel-humo">
            Hay <%= critical_products.count - 6 %> productos críticos más. Usa la lista rápida para revisarlos.
          </p>
        </div>
      <% end %>
    <% else %>
      <div class="px-4 py-8 text-center sm:px-6">
        <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-unel-crema text-lg font-bold text-unel-verde">
          ✓
        </div>

        <p class="mt-3 text-lg font-bold text-unel-carbon">
          No hay productos críticos
        </p>

        <p class="mx-auto mt-2 max-w-md text-sm text-unel-humo">
          Todos los productos tienen stock por sobre su umbral definido.
        </p>
      </div>
    <% end %>
  </div>

  <div class="mt-6 grid gap-5 xl:grid-cols-[1.6fr_0.85fr]">
    <div data-controller="table-filter table-sort" class="rounded-2xl border border-unel-crema-2 bg-white shadow-sm">
      <div class="flex flex-col gap-3 border-b border-unel-crema-2 px-4 py-4 sm:px-6 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <h2 class="text-lg font-bold text-unel-carbon">
            Lista rápida de stock
          </h2>

          <p class="mt-1 text-sm text-unel-humo">
            Busca un producto y accede rápido a su edición o registro de movimiento.
          </p>
        </div>

        <% if products.any? %>
          <div class="flex w-full flex-col gap-2 sm:flex-row sm:items-center lg:w-auto">
            <span data-table-filter-target="resultsCount" class="text-xs text-unel-humo">
            </span>

            <div class="flex w-full items-center gap-2 rounded-xl border border-unel-crema-2 px-4 py-2 sm:w-auto">
              <label for="inventory_sort" class="shrink-0 text-xs font-semibold text-unel-humo">
                Ordenar:
              </label>

              <select
                id="inventory_sort"
                data-table-sort-target="select"
                data-action="change->table-sort#sort"
                class="w-full bg-transparent text-sm font-semibold text-unel-verde outline-none sm:w-48"
              >
                <option value="stock_asc">Menor stock primero</option>
                <option value="stock_desc">Mayor stock primero</option>
                <option value="name_asc">Nombre A-Z</option>
                <option value="name_desc">Nombre Z-A</option>
              </select>
            </div>

            <div class="w-full rounded-xl bg-unel-crema px-4 py-2 sm:w-auto">
              <input
                type="search"
                placeholder="Buscar producto..."
                data-table-filter-target="input"
                data-action="input->table-filter#filter"
                class="w-full bg-transparent text-sm text-unel-negro outline-none placeholder:text-unel-humo sm:w-56"
              >
            </div>
          </div>
        <% end %>
      </div>

      <% if products.any? %>
        <div class="overflow-x-auto">
          <table class="min-w-180 w-full text-left text-sm">
            <thead class="bg-unel-verde text-xs uppercase tracking-wide text-unel-blanco">
              <tr>
                <th class="px-6 py-4 font-semibold">Producto</th>
                  <th class="px-6 py-4 font-semibold">Stock</th>
                  <th class="px-6 py-4 font-semibold">Umbral</th>
                  <th class="px-6 py-4 font-semibold">Estado</th>
                  <th class="px-6 py-4 text-right font-semibold">Acción rápida</th>
              </tr>
            </thead>

            <tbody data-table-sort-target="body" class="divide-y divide-unel-crema-2">
              <% products.each do |product| %>
                <% stock = product.stock.to_i %>
                <% product_threshold = product_low_stock_threshold.call(product) %>

                <% if stock <= 0 %>
                  <% status_label = "Agotado" %>
                  <% status_classes = "border-red-200 bg-red-50 text-red-700" %>
                <% elsif stock <= product_threshold %>
                  <% status_label = "Stock bajo" %>
                  <% status_classes = "border-amber-200 bg-amber-50 text-amber-700" %>
                <% else %>
                  <% status_label = "Disponible" %>
                  <% status_classes = "border-unel-crema-2 bg-white text-unel-verde" %>
                <% end %>

                <tr
                  data-table-filter-target="row"
                  data-table-sort-target="row"
                  data-search-text="<%= [product.name, status_label, stock, product_threshold].join(' ') %>"
                  data-sort-name="<%= product.name %>"
                  data-sort-stock="<%= stock %>"
                  class="transition hover:bg-unel-crema/50"
                >
                  <td class="px-6 py-4">
                    <div class="flex items-center gap-3">
                      <% if product.image.attached? %>
                        <%= image_tag product.image, class: "h-10 w-10 rounded-lg border border-unel-crema-2 object-cover" %>
                      <% else %>
                        <div class="flex h-10 w-10 items-center justify-center rounded-lg border border-unel-crema-2 bg-unel-crema text-center text-xs leading-tight text-unel-humo">
                          Sin foto
                        </div>
                      <% end %>

                      <div>
                        <%= link_to product.name, admin_product_path(product),
                          class: "font-semibold text-unel-negro transition hover:text-unel-dorado" %>

                        <p class="mt-1 text-xs text-unel-humo">
                          Producto terminado
                        </p>
                      </div>
                    </div>
                  </td>

                  <td class="px-6 py-4">
                    <p class="font-bold text-unel-carbon">
                      <%= stock %>
                    </p>

                    <p class="text-xs text-unel-humo">
                      unidades
                    </p>
                  </td>
                  <td class="px-6 py-4 text-unel-humo">
                    <%= product_threshold %> unidades
                  </td>

                  <td class="px-6 py-4">
                    <span class="inline-flex rounded-full border px-3 py-1 text-xs font-semibold <%= status_classes %>">
                      <%= status_label %>
                    </span>
                  </td>

                  <td class="px-6 py-4">
                    <div class="flex items-center justify-end gap-3">
                      <% if movement_new_path_available %>
                        <%= link_to "Movimiento", new_admin_inventory_movement_path(product_id: product.id),
                          class: "text-sm font-semibold text-unel-dorado transition hover:text-unel-dorado-2" %>
                      <% end %>

                      <%= link_to "Editar", edit_admin_product_path(product),
                        class: "text-sm font-semibold text-unel-humo transition hover:text-unel-dorado" %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <div data-table-filter-target="emptyState" class="hidden border-t border-unel-crema-2 px-4 py-12 text-center sm:px-6">
          <p class="text-lg font-bold text-unel-negro">
            No encontramos productos con esa búsqueda
          </p>

          <p class="mx-auto mt-2 max-w-md text-sm text-unel-humo">
            Intenta buscar por nombre, estado o cantidad de stock.
          </p>

          <button
            type="button"
            data-action="table-filter#clear"
            class="mt-6 rounded-xl border border-unel-crema-2 px-4 py-2 text-sm font-semibold text-unel-humo transition hover:border-unel-dorado hover:text-unel-dorado"
          >
            Limpiar búsqueda
          </button>
        </div>
      <% else %>
        <div class="px-4 py-12 text-center sm:px-6">
          <p class="text-lg font-bold text-unel-negro">
            Todavía no hay productos para gestionar inventario
          </p>

          <p class="mx-auto mt-2 max-w-md text-sm text-unel-humo">
            Crea productos con stock inicial para poder gestionar entradas, salidas y ajustes.
          </p>

          <div class="mt-6">
            <%= link_to "Crear primer producto", new_admin_product_path,
              class: "rounded-xl bg-unel-verde px-4 py-2 text-sm font-semibold text-unel-blanco transition hover:bg-unel-carbon" %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="rounded-2xl border border-unel-crema-2 bg-white p-5 shadow-sm">
      <p class="text-sm font-semibold uppercase tracking-wide text-unel-dorado">
        Historial reciente
      </p>

      <h2 class="mt-2 text-lg font-bold text-unel-carbon">
        Últimos movimientos
      </h2>

      <div class="mt-4 rounded-xl border border-dashed border-unel-crema-2 bg-unel-blanco px-4 py-6 text-center">
        <p class="text-sm font-bold text-unel-carbon">
          Historial pendiente
        </p>

        <p class="mx-auto mt-2 max-w-sm text-sm text-unel-humo">
          Cuando se conecten los movimientos reales, aquí aparecerán las últimas entradas, salidas y ajustes.
        </p>

        <% if movement_new_path_available %>
          <%= link_to "Registrar movimiento", new_admin_inventory_movement_path,
            class: "mt-4 inline-flex rounded-xl bg-unel-verde px-4 py-2 text-sm font-semibold text-white transition hover:bg-unel-carbon" %>
        <% else %>
          <%= link_to "Editar productos", admin_products_path,
            class: "mt-4 inline-flex rounded-xl bg-unel-verde px-4 py-2 text-sm font-semibold text-white transition hover:bg-unel-carbon" %>
        <% end %>
      </div>

      <div class="mt-4 space-y-2.5">
        <div class="flex items-center justify-between rounded-xl bg-unel-crema px-4 py-3">
          <span class="text-sm font-semibold text-unel-carbon">
            Productos disponibles
          </span>

          <span class="text-sm font-bold text-unel-verde">
            <%= available_products %>
          </span>
        </div>

        <div class="flex items-center justify-between rounded-xl bg-red-50 px-4 py-3">
          <span class="text-sm font-semibold text-red-700">
            Sin stock
          </span>

          <span class="text-sm font-bold text-red-700">
            <%= out_of_stock_products.count %>
          </span>
        </div>

        <div class="flex items-center justify-between rounded-xl bg-amber-50 px-4 py-3">
          <span class="text-sm font-semibold text-amber-700">
            Por reponer
          </span>

          <span class="text-sm font-bold text-amber-700">
            <%= low_stock_products.count %>
          </span>
        </div>
      </div>
    </div>
  </div>

  
</section>