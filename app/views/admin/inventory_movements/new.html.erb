<% content_for :admin_section_key, "inventory" %>
<% content_for :admin_section_inner, "Nuevo movimiento" %>
<% content_for :admin_search_placeholder, "Buscar inventario..." %>
<% content_for :admin_search_path, admin_inventory_movements_path %>

<% products = (@products || []).to_a %>
<% selected_product_id = @selected_product_id.presence %>
<% selected_movement_type = @selected_movement_type.presence || "entry" %>
<% movement_create_backend_ready = controller.class.action_methods.include?("create") %>
<% default_low_stock_threshold = 5 %>

<% product_low_stock_threshold = lambda do |product|
  if product.respond_to?(:low_stock_threshold) && product.low_stock_threshold.present?
    product.low_stock_threshold.to_i
  else
    default_low_stock_threshold
  end
end %>

<section
  data-controller="inventory-movement-form"
  data-inventory-movement-form-backend-ready-value="<%= movement_create_backend_ready %>"
>
  <div class="mb-8 flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-unel-carbon md:text-3xl">
        Registrar movimiento
      </h1>

      <p class="mt-2 max-w-2xl text-sm text-unel-humo">
        Registra entradas, salidas o ajustes de stock para mantener el inventario actualizado.
      </p>
    </div>

    <%= link_to "Volver a inventario", admin_inventory_movements_path,
      class: "rounded-xl border border-unel-crema-2 px-4 py-2 text-center text-sm font-semibold text-unel-humo transition hover:border-unel-dorado hover:text-unel-dorado" %>
  </div>

  <% unless movement_create_backend_ready %>
    <div class="mb-6 rounded-2xl border border-amber-100 bg-amber-50 px-4 py-4 text-sm text-amber-800 shadow-sm sm:px-5">
      <p class="font-bold">
        Pendiente de conexión backend
      </p>

      <p class="mt-1">
        El formulario ya está preparado visualmente, pero el guardado real quedará deshabilitado hasta que exista la acción <strong>create</strong> y el modelo de movimientos.
      </p>
    </div>
  <% end %>

  <div class="grid gap-6 xl:grid-cols-[1.25fr_0.8fr]">
    <div class="rounded-2xl border border-unel-crema-2 bg-white shadow-sm">
      <div class="border-b border-unel-crema-2 px-4 py-5 sm:px-6">
        <p class="text-sm font-semibold uppercase tracking-wide text-unel-dorado">
          Movimiento
        </p>

        <h2 class="mt-2 text-xl font-bold text-unel-carbon">
          Datos del movimiento
        </h2>

        <p class="mt-1 text-sm text-unel-humo">
          Selecciona el tipo de cambio que quieres registrar y el producto afectado.
        </p>
      </div>

      <%= form_with scope: :inventory_movement,
        url: admin_inventory_movements_path,
        method: :post,
        local: true,
        class: "space-y-6 px-4 py-5 sm:px-6" do |form| %>

        <div>
          <p class="block text-sm font-semibold text-unel-carbon">
            Tipo de movimiento
          </p>

          <div class="mt-3 grid gap-3 md:grid-cols-3">
            <label class="cursor-pointer">
              <%= radio_button_tag "inventory_movement[movement_type]",
                "entry",
                selected_movement_type == "entry",
                data: {
                  inventory_movement_form_target: "typeInput",
                  action: "change->inventory-movement-form#update"
                },
                class: "peer sr-only" %>

              <div class="rounded-xl border border-unel-crema-2 bg-unel-crema p-4 transition peer-checked:border-unel-verde peer-checked:bg-white peer-checked:shadow-sm">
                <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-unel-verde text-xl font-bold text-white">
                  +
                </div>

                <p class="mt-3 font-bold text-unel-carbon">
                  Entrada
                </p>

                <p class="mt-1 text-sm text-unel-humo">
                  Suma unidades al stock.
                </p>
              </div>
            </label>

            <label class="cursor-pointer">
              <%= radio_button_tag "inventory_movement[movement_type]",
                "exit",
                selected_movement_type == "exit",
                data: {
                  inventory_movement_form_target: "typeInput",
                  action: "change->inventory-movement-form#update"
                },
                class: "peer sr-only" %>

              <div class="rounded-xl border border-red-100 bg-red-50 p-4 transition peer-checked:border-red-300 peer-checked:bg-white peer-checked:shadow-sm">
                <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-red-500 text-xl font-bold text-white">
                  −
                </div>

                <p class="mt-3 font-bold text-unel-carbon">
                  Salida
                </p>

                <p class="mt-1 text-sm text-unel-humo">
                  Resta unidades del stock.
                </p>
              </div>
            </label>

            <label class="cursor-pointer">
              <%= radio_button_tag "inventory_movement[movement_type]",
                "adjustment",
                selected_movement_type == "adjustment",
                data: {
                  inventory_movement_form_target: "typeInput",
                  action: "change->inventory-movement-form#update"
                },
                class: "peer sr-only" %>

              <div class="rounded-xl border border-amber-100 bg-amber-50 p-4 transition peer-checked:border-amber-300 peer-checked:bg-white peer-checked:shadow-sm">
                <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-unel-dorado text-xl font-bold text-white">
                  ±
                </div>

                <p class="mt-3 font-bold text-unel-carbon">
                  Ajuste
                </p>

                <p class="mt-1 text-sm text-unel-humo">
                  Define el stock real.
                </p>
              </div>
            </label>
          </div>
        </div>

        <div>
          <%= form.label :product_id, "Producto", class: "block text-sm font-semibold text-unel-carbon" %>

          <select
            name="inventory_movement[product_id]"
            id="inventory_movement_product_id"
            data-inventory-movement-form-target="productSelect"
            data-action="change->inventory-movement-form#update"
            class="mt-2 w-full rounded-xl border border-unel-crema-2 bg-unel-blanco px-4 py-3 text-sm text-unel-carbon outline-none transition focus:border-unel-dorado"
          >
            <option value="">Selecciona un producto</option>

            <% products.each do |product| %>
              <% product_threshold = product_low_stock_threshold.call(product) %>

              <option
                value="<%= product.id %>"
                data-name="<%= product.name %>"
                data-stock="<%= product.stock.to_i %>"
                data-threshold="<%= product_threshold %>"
                <%= "selected" if selected_product_id.to_s == product.id.to_s %>
              >
                <%= product.name %> · Stock: <%= product.stock.to_i %> · Umbral: <%= product_threshold %>
              </option>
            <% end %>
          </select>
        </div>

        <div class="grid gap-5 md:grid-cols-2">
          <div>
            <label
              for="inventory_movement_quantity"
              data-inventory-movement-form-target="quantityLabel"
              class="block text-sm font-semibold text-unel-carbon"
            >
              Cantidad
            </label>

            <%= form.number_field :quantity,
              min: 0,
              step: 1,
              value: 0,
              data: {
                inventory_movement_form_target: "quantityInput",
                action: "input->inventory-movement-form#update"
              },
              class: "mt-2 w-full rounded-xl border border-unel-crema-2 bg-unel-blanco px-4 py-3 text-sm text-unel-carbon outline-none transition focus:border-unel-dorado" %>

            <p data-inventory-movement-form-target="quantityHelp" class="mt-2 text-xs text-unel-humo">
              Ingresa la cantidad del movimiento.
            </p>
          </div>

          <div>
            <%= form.label :reason, "Motivo", class: "block text-sm font-semibold text-unel-carbon" %>

            <select
              name="inventory_movement[reason]"
              id="inventory_movement_reason"
              data-inventory-movement-form-target="reasonSelect"
              class="mt-2 w-full rounded-xl border border-unel-crema-2 bg-unel-blanco px-4 py-3 text-sm text-unel-carbon outline-none transition focus:border-unel-dorado"
            >
              <option value="">Selecciona un motivo</option>

              <option value="production" data-types="entry">Producción</option>
              <option value="return" data-types="entry">Devolución</option>
              <option value="positive_correction" data-types="entry">Corrección positiva</option>

              <option value="sale" data-types="exit">Venta</option>
              <option value="waste" data-types="exit">Merma</option>
              <option value="withdrawal" data-types="exit">Retiro</option>
              <option value="negative_correction" data-types="exit">Corrección negativa</option>

              <option value="physical_count" data-types="adjustment">Conteo físico</option>
              <option value="inventory_correction" data-types="adjustment">Corrección de inventario</option>

              <option value="other" data-types="entry,exit,adjustment">Otro</option>
            </select>
          </div>
        </div>

        <div>
          <%= form.label :note, "Comentario opcional", class: "block text-sm font-semibold text-unel-carbon" %>

          <%= form.text_area :note,
            rows: 4,
            placeholder: "Ejemplo: producción del día, venta directa, corrección por conteo físico...",
            class: "mt-2 w-full rounded-xl border border-unel-crema-2 bg-unel-blanco px-4 py-3 text-sm text-unel-carbon outline-none transition placeholder:text-unel-humo focus:border-unel-dorado" %>
        </div>

        <p
          data-inventory-movement-form-target="warning"
          class="hidden rounded-xl border border-red-100 bg-red-50 px-4 py-3 text-sm font-semibold text-red-700"
        >
        </p>

        <div class="flex flex-col-reverse gap-3 border-t border-unel-crema-2 pt-5 sm:flex-row sm:items-center sm:justify-end">
          <%= link_to "Cancelar", admin_inventory_movements_path,
            class: "rounded-xl border border-unel-crema-2 px-4 py-2 text-center text-sm font-semibold text-unel-humo transition hover:border-unel-dorado hover:text-unel-dorado" %>

          <%= form.submit "Guardar movimiento",
            data: { inventory_movement_form_target: "submitButton" },
            disabled: !movement_create_backend_ready,
            class: "cursor-pointer rounded-xl bg-unel-verde px-4 py-2 text-sm font-semibold text-white transition hover:bg-unel-carbon disabled:cursor-not-allowed disabled:bg-unel-humo" %>
        </div>
      <% end %>
    </div>

    <aside class="space-y-5">
      <div class="rounded-2xl border border-unel-crema-2 bg-white p-5 shadow-sm">
        <p class="text-sm font-semibold uppercase tracking-wide text-unel-dorado">
          Vista previa
        </p>

        <h2 data-inventory-movement-form-target="selectedProductName" class="mt-2 text-xl font-bold text-unel-carbon">
          Selecciona un producto
        </h2>

        <div class="mt-5 space-y-3">
          <div class="flex items-center justify-between rounded-xl bg-unel-crema px-4 py-3">
            <span class="text-sm font-semibold text-unel-carbon">
              Stock actual
            </span>

            <span data-inventory-movement-form-target="currentStock" class="text-sm font-bold text-unel-carbon">
              0 unidades
            </span>
          </div>

          <div class="flex items-center justify-between rounded-xl bg-unel-blanco px-4 py-3">
            <span class="text-sm font-semibold text-unel-carbon">
              Umbral del producto
            </span>

            <span data-inventory-movement-form-target="threshold" class="text-sm font-bold text-unel-humo">
              5 unidades
            </span>
          </div>

          <div class="flex items-center justify-between rounded-xl bg-unel-blanco px-4 py-3">
            <span class="text-sm font-semibold text-unel-carbon">
              Diferencia
            </span>

            <span data-inventory-movement-form-target="difference" class="text-sm font-bold text-unel-dorado">
              Sin cambio
            </span>
          </div>

          <div class="rounded-xl border border-unel-crema-2 bg-white px-4 py-4">
            <p class="text-xs font-semibold uppercase tracking-wide text-unel-humo">
              Stock resultante
            </p>

            <div class="mt-2 flex flex-wrap items-center justify-between gap-3">
              <span data-inventory-movement-form-target="resultingStock" class="text-2xl font-bold text-unel-carbon">
                0 unidades
              </span>

              <span data-inventory-movement-form-target="statusBadge" class="inline-flex rounded-full border border-unel-crema-2 bg-white px-3 py-1 text-xs font-semibold text-unel-verde">
                Disponible
              </span>
            </div>
          </div>
        </div>
      </div>

      <div class="rounded-2xl border border-unel-crema-2 bg-white p-5 shadow-sm">
        <p class="text-sm font-semibold uppercase tracking-wide text-unel-dorado">
          Cómo usarlo
        </p>

        <div class="mt-4 space-y-3 text-sm text-unel-humo">
          <p>
            <strong class="text-unel-carbon">Entrada:</strong> úsala cuando se produzcan o ingresen nuevas unidades.
          </p>

          <p>
            <strong class="text-unel-carbon">Salida:</strong> úsala para ventas, mermas o retiros.
          </p>

          <p>
            <strong class="text-unel-carbon">Ajuste:</strong> úsalo cuando el conteo físico no coincida con el sistema.
          </p>
        </div>
      </div>
    </aside>
  </div>
</section>