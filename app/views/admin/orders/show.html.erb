    "Sin segmento" %>
  <% customer_phone = order_attribute.call(order_record, :customer_phone, nil).presence ||
    order_attribute.call(order_record, :phone, nil).presence ||
    customer_record.try(:phone) %>
  <% customer_address = order_attribute.call(order_record, :customer_address, nil).presence ||
    order_attribute.call(order_record, :address, nil).presence ||
    customer_record.try(:address) %>

  <% order_date = order_attribute.call(order_record, :order_date, nil).presence ||
    order_attribute.call(order_record, :created_at, nil) %>
  <% delivery_date = order_attribute.call(order_record, :delivery_date, nil).presence ||
    order_attribute.call(order_record, :estimated_delivery_date, nil) %>
  <% payment_due_date = order_attribute.call(order_record, :payment_due_date, nil).presence ||
    order_attribute.call(order_record, :due_date, nil) %>

  <% order_status = order_attribute.call(order_record, :order_status, nil).presence ||
    order_attribute.call(order_record, :status, "pending_confirmation").to_s %>
  <% payment_status = order_attribute.call(order_record, :payment_status, "pending").to_s %>

  <% total_amount = (order_attribute.call(order_record, :total_amount, nil).presence ||
    order_attribute.call(order_record, :total, 0)).to_f %>
  <% paid_amount = (order_attribute.call(order_record, :paid_amount, nil).presence ||
    order_attribute.call(order_record, :amount_paid, 0)).to_f %>
  <% balance_amount = [total_amount - paid_amount, 0].max %>

  <% channel = order_attribute.call(order_record, :channel, "Manual") %>
  <% sale_source = order_attribute.call(order_record, :sale_source, nil).presence || channel %>
  <% delivery_method = order_attribute.call(order_record, :delivery_method, "Sin método definido") %>
  <% payment_method = order_attribute.call(order_record, :payment_method, "Sin método definido") %>
  <% notes = order_attribute.call(order_record, :notes, nil) %>
  <% internal_notes = order_attribute.call(order_record, :internal_notes, nil) %>

  <% items = order_attribute.call(order_record, :items, nil).presence ||
    order_attribute.call(order_record, :order_items, nil).presence ||
    [] %>
  <% items = items.respond_to?(:to_a) ? items.to_a : [] %>

  <% activities = if defined?(@activities) && @activities.present?
    @activities.to_a
  else
    order_attribute.call(order_record, :activities, nil).presence || []
  end %>
  <% activities = activities.respond_to?(:to_a) ? activities.to_a : [] %>

  <% payment_overdue = balance_amount.positive? &&
    payment_due_date.present? &&
    payment_due_date.respond_to?(:to_date) &&
    payment_due_date.to_date < Date.current %>

  <% delivery_overdue = !["delivered", "cancelled"].include?(order_status) &&
    delivery_date.present? &&
    delivery_date.respond_to?(:to_date) &&
    delivery_date.to_date < Date.current %>

  <% action_recommendation = if delivery_overdue
    "Revisar entrega atrasada"
  elsif payment_overdue
    "Contactar por pago vencido"
  elsif order_status == "pending_confirmation"
    "Revisar nueva venta"
  elsif order_status == "in_production"
    "Preparar productos y confirmar avance"
  elsif order_status == "ready"
    "Coordinar entrega con el cliente"
  elsif order_status == "delivered" && balance_amount.positive?
    "Cobrar saldo pendiente"
  elsif payment_status == "partial" && balance_amount.positive?
    "Hacer seguimiento del pago parcial"
  else
    "Sin acción urgente"
  end %>

  <% primary_action_label = if order_status == "delivered" && balance_amount.zero?
    "Venta finalizada"
  elsif order_status == "delivered" && balance_amount.positive?
    "Registrar pago"
  elsif payment_overdue
    "Registrar pago"
  elsif order_status == "pending_confirmation"
    "Marcar en preparación"
  elsif order_status == "in_production"
    "Marcar lista para entregar"
  elsif order_status == "ready"
    "Marcar como entregada"
  else
    "Actualizar estado"
  end %>

  <% primary_action_disabled = order_status == "delivered" && balance_amount.zero? %>
  <% payment_action_disabled = balance_amount.zero? %>
  <% payment_action_label = balance_amount.positive? ? "Registrar pago" : "Pago registrado" %>
  <% show_payment_action = balance_amount.positive? && primary_action_label != payment_action_label %>

  <% payment_percentage = total_amount.positive? ? [[(paid_amount / total_amount) * 100, 100].min, 0].max : 0 %>
  <% total_units = items.sum { |item| item_attribute.call(item, :quantity, 0).to_i } %>
  <% phone_href = customer_phone.present? ? customer_phone.to_s.gsub(/[^\d+]/, "") : nil %>

  <% customer_path = if customer_id.present?
    orders_preview ? admin_customer_path(customer_id, preview: preview_mode) : admin_customer_path(customer_id)
  else
    admin_customers_path
  end %>

  <section>
    <div class="mb-8 flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
      <div>
        <%= link_to "← Volver a ventas", orders_back_path,
          class: "mb-4 inline-flex text-sm font-semibold text-unel-dorado transition hover:text-unel-carbon" %>

        <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-unel-dorado">
          Gestión de venta
        </p>

        <div class="flex flex-wrap items-center gap-3">
          <h1 class="text-2xl font-bold text-unel-carbon md:text-3xl">
            <%= code %>
          </h1>

          <span class="rounded-full border px-3 py-1 text-xs font-semibold <%= status_classes.call(order_status) %>">
            <%= status_label.call(order_status) %>
          </span>

          <span class="rounded-full border px-3 py-1 text-xs font-semibold <%= payment_classes.call(payment_status, payment_overdue) %>">
            <%= payment_label.call(payment_status, payment_overdue) %>
          </span>
        </div>

        <p class="mt-2 max-w-2xl text-sm text-unel-humo">
          Venta de <span class="font-semibold text-unel-carbon"><%= customer_name %></span>, recibida por <%= sale_source %>.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <span class="inline-flex w-fit rounded-full border border-unel-crema-2 bg-unel-crema px-3 py-1 text-xs font-semibold text-unel-humo">
          <%= formatted_date.call(order_date) %>
        </span>

        <span class="inline-flex w-fit rounded-full border border-unel-crema-2 bg-white px-3 py-1 text-xs font-semibold text-unel-humo">
          <%= total_units %> unidades
        </span>
      </div>
    </div>

    <div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_24rem]">
      <div class="space-y-6">
        <div class="rounded-3xl border border-unel-crema-2 bg-white shadow-sm">
          <div class="border-b border-unel-crema-2 p-5 sm:p-6">
            <p class="text-sm font-semibold uppercase tracking-wide text-unel-dorado">
              Próxima acción
            </p>

            <div class="mt-3 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
