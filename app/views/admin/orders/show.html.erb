<% order_attribute = lambda do |order, attribute, default = nil|
  if order.respond_to?(attribute)
    order.public_send(attribute)
  elsif order.respond_to?(:[])
    order[attribute] || order[attribute.to_s] || default
  else
    default
  end
end %>

<% item_attribute = lambda do |item, attribute, default = nil|
  if item.respond_to?(attribute)
    item.public_send(attribute)
  elsif item.respond_to?(:[])
    item[attribute] || item[attribute.to_s] || default
  else
    default
  end
end %>

<% activity_attribute = lambda do |activity, attribute, default = nil|
  if activity.respond_to?(attribute)
    activity.public_send(attribute)
  elsif activity.respond_to?(:[])
    activity[attribute] || activity[attribute.to_s] || default
  else
    default
  end
end %>

<% preview_order = orders_preview ? preview_orders.find { |order| order[:id].to_s == params[:id].to_s } : nil %>

<% order_record = if defined?(@order) && @order.present?
  @order
else
  preview_order
end %>

<% orders_back_path = orders_preview ? admin_orders_path(preview: preview_mode) : admin_orders_path %>

<% formatted_date = lambda do |date, fallback = "Sin fecha"|
  if date.present? && date.respond_to?(:strftime)
    date.strftime("%d/%m/%Y")
  elsif date.present?
    date.to_s
  else
    fallback
  end
end %>

<% days_label = lambda do |date|
  if date.blank? || !date.respond_to?(:to_date)
    nil
  else
    difference = (date.to_date - Date.current).to_i

    if difference == 0
      "Hoy"
    elsif difference == 1
      "Mañana"
    elsif difference.positive?
      "En #{difference} días"
    elsif difference == -1
      "Ayer"
    else
      "Hace #{difference.abs} días"
    end
  end
end %>

<% status_label = lambda do |status|
  case status
  when "pending_confirmation"
    "Nueva venta"
  when "in_production"
    "En preparación"
  when "ready"
    "Lista para entregar"
  when "delivered"
    "Entregada"
  when "cancelled"
    "Cancelada"
  else
    status.to_s.humanize
  end
end %>

<% status_classes = lambda do |status|
  case status
  when "pending_confirmation"
    "border-amber-200 bg-amber-50 text-amber-700"
  when "in_production"
    "border-unel-crema-2 bg-unel-crema text-unel-verde"
  when "ready"
    "border-green-200 bg-green-50 text-green-700"
  when "delivered"
    "border-unel-crema-2 bg-white text-unel-humo"
  when "cancelled"
    "border-red-200 bg-red-50 text-red-700"
  else
    "border-unel-crema-2 bg-unel-crema text-unel-humo"
  end
end %>

<% payment_label = lambda do |status, overdue = false|
  if overdue
    "Vencido"
  else
    case status
    when "paid"
      "Pagado"
    when "partial"
      "Pago parcial"
    when "pending"
      "Pendiente"
    else
      status.to_s.humanize
    end
  end
end %>

<% payment_classes = lambda do |status, overdue = false|
  if overdue
    "border-red-200 bg-red-50 text-red-700"
  else
    case status
    when "paid"
      "border-green-200 bg-green-50 text-green-700"
    when "partial"
      "border-amber-200 bg-amber-50 text-amber-700"
    when "pending"
      "border-unel-crema-2 bg-white text-unel-humo"
    else
      "border-unel-crema-2 bg-unel-crema text-unel-humo"
    end
  end
end %>

