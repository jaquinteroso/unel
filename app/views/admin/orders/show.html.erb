                  <%= primary_action_label %>
                </button>
              </div>
            </div>
          </div>

          <div class="grid gap-3 p-5 sm:grid-cols-3 sm:p-6">
            <div class="rounded-2xl bg-unel-crema px-4 py-3">
              <p class="text-xs font-semibold uppercase tracking-wide text-unel-humo">
                Total venta
              </p>

              <p class="mt-1 text-xl font-bold text-unel-dorado">
                <%= number_to_currency(total_amount, unit: "$", precision: 0, delimiter: ".") %>
              </p>
            </div>

            <div class="rounded-2xl bg-unel-crema px-4 py-3">
              <p class="text-xs font-semibold uppercase tracking-wide text-unel-humo">
                Pagado
              </p>

              <p class="mt-1 text-xl font-bold text-unel-carbon">
                <%= number_to_currency(paid_amount, unit: "$", precision: 0, delimiter: ".") %>
              </p>
            </div>

            <div class="rounded-2xl border <%= balance_amount.positive? ? (payment_overdue ? "border-red-200 bg-red-50" : "border-amber-200 bg-amber-50") : "border-green-200 bg-green-50" %> px-4 py-3">
              <p class="text-xs font-semibold uppercase tracking-wide <%= balance_amount.positive? ? (payment_overdue ? "text-red-700" : "text-amber-700") : "text-green-700" %>">
                Saldo
              </p>

              <p class="mt-1 text-xl font-bold <%= balance_amount.positive? ? (payment_overdue ? "text-red-700" : "text-amber-700") : "text-green-700" %>">
                <%= balance_amount.positive? ? number_to_currency(balance_amount, unit: "$", precision: 0, delimiter: ".") : "Pagado" %>
              </p>
            </div>
          </div>
        </div>

        <div class="rounded-3xl border border-unel-crema-2 bg-white shadow-sm">
          <div class="border-b border-unel-crema-2 px-5 py-4 sm:px-6">
            <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <h2 class="text-lg font-bold text-unel-carbon">
                  Productos solicitados
                </h2>

                <p class="mt-1 text-sm text-unel-humo">
                  Productos, formatos, cantidades y valores asociados a esta venta.
                </p>
              </div>

              <span class="inline-flex w-fit rounded-full border border-unel-crema-2 bg-unel-crema px-3 py-1 text-xs font-semibold text-unel-humo">
                <%= total_units %> unidades
              </span>
            </div>
          </div>

          <% if items.any? %>
            <div class="divide-y divide-unel-crema-2">
              <% items.each do |item| %>
                <% product_record = item_attribute.call(item, :product, nil) %>
                <% item_name = item_attribute.call(item, :name, nil).presence ||
                  item_attribute.call(item, :product_name, nil).presence ||
                  product_record.try(:name).presence ||
                  "Producto" %>
                <% item_format = item_attribute.call(item, :format, nil).presence ||
                  product_record.try(:format) %>
                <% item_sku = item_attribute.call(item, :sku, nil).presence ||
                  product_record.try(:sku) %>
                <% item_quantity = item_attribute.call(item, :quantity, 0).to_i %>
                <% item_unit_price = (item_attribute.call(item, :unit_price, nil).presence ||
                  item_attribute.call(item, :price, 0)).to_f %>
                <% item_subtotal = (item_attribute.call(item, :subtotal, nil).presence ||
                  item_attribute.call(item, :total_price, nil).presence ||
                  (item_quantity * item_unit_price)).to_f %>

                <div class="grid gap-4 px-5 py-4 sm:grid-cols-[minmax(0,1fr)_8rem_8rem] sm:items-center sm:px-6">
                  <div class="min-w-0">
                    <p class="font-bold text-unel-carbon">
                      <%= item_name %>
                    </p>

                    <p class="mt-1 text-sm text-unel-humo">
                      <%= [item_format, item_sku, (item_unit_price.positive? ? "#{number_to_currency(item_unit_price, unit: "$", precision: 0, delimiter: ".")} c/u" : nil)].compact.join(" · ").presence || "Sin formato informado" %>
                    </p>
                  </div>

                  <div class="rounded-2xl bg-unel-blanco px-4 py-3 text-left sm:text-center">
                    <p class="text-xs font-semibold uppercase tracking-wide text-unel-humo">
                      Cantidad
                    </p>

                    <p class="mt-1 text-sm font-bold text-unel-carbon">
                      <%= item_quantity %>
                    </p>
                  </div>

                  <div class="rounded-2xl bg-unel-blanco px-4 py-3 text-left sm:text-center">
                    <p class="text-xs font-semibold uppercase tracking-wide text-unel-humo">
                      Subtotal
                    </p>

                    <p class="mt-1 text-sm font-bold text-unel-dorado">
                      <%= number_to_currency(item_subtotal, unit: "$", precision: 0, delimiter: ".") %>
                    </p>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="px-5 py-10 text-center sm:px-6">
              <p class="text-base font-bold text-unel-carbon">
                Sin productos informados
              </p>

              <p class="mx-auto mt-2 max-w-md text-sm text-unel-humo">
                Cuando la venta tenga productos asociados, aparecerán en esta sección.
              </p>
            </div>
          <% end %>
        </div>

        <div class="rounded-3xl border border-unel-crema-2 bg-white shadow-sm">
          <div class="border-b border-unel-crema-2 px-5 py-4 sm:px-6">
            <h2 class="text-lg font-bold text-unel-carbon">
              Pago y entrega
            </h2>

            <p class="mt-1 text-sm text-unel-humo">
              Resumen de coordinación, pago y entrega.
            </p>
          </div>

          <div class="grid gap-4 p-5 sm:p-6 lg:grid-cols-2">
            <div class="rounded-2xl border <%= payment_overdue ? "border-red-200 bg-red-50" : "border-unel-crema-2 bg-unel-blanco" %> px-4 py-4">
              <p class="text-xs font-semibold uppercase tracking-wide <%= payment_overdue ? "text-red-700" : "text-unel-humo" %>">
                Estado de pago
              </p>

              <div class="mt-3 flex flex-wrap items-center gap-2">
                <span class="rounded-full border px-3 py-1 text-xs font-semibold <%= payment_classes.call(payment_status, payment_overdue) %>">
                  <%= payment_label.call(payment_status, payment_overdue) %>
                </span>

                <span class="text-sm font-bold text-unel-carbon">
                  <%= payment_method %>
                </span>
              </div>

              <div class="mt-4 h-2 overflow-hidden rounded-full bg-white">
                <div class="h-full rounded-full bg-unel-verde" style="width: <%= payment_percentage %>%"></div>
              </div>

              <p class="mt-3 text-sm text-unel-humo">
                Vence:
                <span class="font-semibold text-unel-carbon">
                  <%= formatted_date.call(payment_due_date, "Sin fecha") %>
                </span>
              </p>
            </div>

            <div class="rounded-2xl border <%= delivery_overdue ? "border-red-200 bg-red-50" : "border-unel-crema-2 bg-unel-blanco" %> px-4 py-4">
              <p class="text-xs font-semibold uppercase tracking-wide <%= delivery_overdue ? "text-red-700" : "text-unel-humo" %>">
                Entrega
              </p>

              <p class="mt-3 text-sm font-bold text-unel-carbon">
                <%= delivery_method %>
              </p>

              <p class="mt-2 text-sm text-unel-humo">
                Fecha:
                <span class="font-semibold text-unel-carbon">
                  <%= formatted_date.call(delivery_date, "Sin definir") %>
                </span>
              </p>

              <% if days_label.call(delivery_date).present? %>
                <p class="mt-1 text-sm <%= delivery_overdue ? "text-red-700" : "text-unel-humo" %>">
                  <%= days_label.call(delivery_date) %>
                </p>
              <% end %>
            </div>
          </div>
        </div>

        <div class="rounded-3xl border border-unel-crema-2 bg-white shadow-sm">
          <div class="border-b border-unel-crema-2 px-5 py-4 sm:px-6">
            <h2 class="text-lg font-bold text-unel-carbon">
              Actividad de la venta
            </h2>

            <p class="mt-1 text-sm text-unel-humo">
              Eventos relevantes asociados a esta venta.
            </p>
          </div>

          <% if activities.any? %>
            <div class="divide-y divide-unel-crema-2">
              <% activities.each do |activity| %>
                <% activity_date = activity_attribute.call(activity, :date, nil).presence ||
                  activity_attribute.call(activity, :created_at, nil) %>
                <% activity_title = activity_attribute.call(activity, :title, "Actividad") %>
                <% activity_description = activity_attribute.call(activity, :description, nil) %>

                <div class="flex gap-4 px-5 py-4 sm:px-6">
                  <div class="mt-1 h-2.5 w-2.5 shrink-0 rounded-full bg-unel-dorado"></div>

                  <div>
                    <p class="text-sm font-bold text-unel-carbon">
                      <%= activity_title %>
                    </p>

                    <% if activity_description.present? %>
                      <p class="mt-1 text-sm text-unel-humo">
                        <%= activity_description %>
                      </p>
                    <% end %>

                    <p class="mt-1 text-xs font-semibold uppercase tracking-wide text-unel-humo">
                      <%= formatted_date.call(activity_date) %>
                    </p>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="px-5 py-10 text-center sm:px-6">
              <p class="text-base font-bold text-unel-carbon">
                Sin actividad registrada
              </p>

              <p class="mx-auto mt-2 max-w-md text-sm text-unel-humo">
                Los cambios de estado, pagos y contactos relevantes aparecerán aquí.
              </p>
            </div>
          <% end %>
        </div>
      </div>

      <aside class="space-y-6">
        <div class="rounded-3xl border border-unel-crema-2 bg-white p-5 shadow-sm sm:p-6">
          <p class="text-sm font-semibold uppercase tracking-wide text-unel-dorado">
            Cliente
          </p>

          <h2 class="mt-2 text-xl font-bold text-unel-carbon">
            <%= customer_name %>
          </h2>

          <p class="mt-1 text-sm font-semibold text-unel-humo">
            <%= customer_segment %>
          </p>

          <div class="mt-5 space-y-3">
            <div class="rounded-2xl bg-unel-blanco px-4 py-3">
              <p class="text-xs font-semibold uppercase tracking-wide text-unel-humo">
                Contacto
              </p>

              <p class="mt-1 text-sm font-bold text-unel-carbon">
                <%= customer_phone.presence || "Sin teléfono informado" %>
              </p>

              <% if customer_email.present? %>
                <p class="mt-1 text-sm text-unel-humo">
                  <%= customer_email %>
                </p>
              <% end %>
            </div>

            <div class="rounded-2xl bg-unel-blanco px-4 py-3">
              <p class="text-xs font-semibold uppercase tracking-wide text-unel-humo">
                Entrega
              </p>

              <p class="mt-1 text-sm font-bold text-unel-carbon">
                <%= customer_address.presence || "Sin dirección informada" %>
              </p>
            </div>
          </div>

          <div class="mt-5 grid gap-2">
            <%= link_to "Ver ficha del cliente", customer_path,
              class: "inline-flex justify-center rounded-xl border border-unel-crema-2 bg-white px-4 py-2 text-sm font-semibold text-unel-humo transition hover:border-unel-dorado hover:text-unel-dorado" %>

            <% if customer_phone.present? %>
              <%= link_to "Llamar cliente", "tel:#{phone_href}",
                class: "inline-flex justify-center rounded-xl bg-unel-verde px-4 py-2 text-sm font-semibold text-white transition hover:bg-unel-carbon" %>
            <% else %>
              <span class="inline-flex justify-center rounded-xl bg-unel-verde px-4 py-2 text-sm font-semibold text-white opacity-50">
                Llamar cliente
              </span>
            <% end %>
          </div>
        </div>

        <div class="rounded-3xl border border-unel-crema-2 bg-white p-5 shadow-sm sm:p-6">
          <p class="text-sm font-semibold uppercase tracking-wide text-unel-dorado">
            Estado de la venta
          </p>

          <% steps = [
            { key: "pending_confirmation", label: "Nueva" },
            { key: "in_production", label: "Preparación" },
            { key: "ready", label: "Lista" },
            { key: "delivered", label: "Entregada" }
          ] %>

          <% current_step_index = steps.find_index { |step| step[:key] == order_status } || 0 %>

          <div class="mt-5 space-y-3">
            <% steps.each_with_index do |step, index| %>
              <% completed = index < current_step_index || order_status == "delivered" %>
              <% current = index == current_step_index && order_status != "delivered" %>

              <div class="flex items-center gap-3">
                <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border text-xs font-bold <%= completed || current ? "border-unel-verde bg-unel-verde text-white" : "border-unel-crema-2 bg-unel-blanco text-unel-humo" %>">
                  <%= index + 1 %>
                </div>

                <p class="text-sm font-semibold <%= completed || current ? "text-unel-carbon" : "text-unel-humo" %>">
                  <%= step[:label] %>
                </p>
              </div>
            <% end %>
          </div>
        </div>

        <div class="rounded-3xl border border-unel-crema-2 bg-white p-5 shadow-sm sm:p-6">
          <p class="text-sm font-semibold uppercase tracking-wide text-unel-dorado">
            Notas
          </p>

          <div class="mt-4 space-y-3">
            <div class="rounded-2xl bg-unel-blanco px-4 py-3">
              <p class="text-xs font-semibold uppercase tracking-wide text-unel-humo">
                Nota de la venta
              </p>

              <p class="mt-1 text-sm leading-relaxed text-unel-carbon">
                <%= notes.presence || "Sin nota registrada." %>
              </p>
            </div>

            <div class="rounded-2xl bg-unel-blanco px-4 py-3">
              <p class="text-xs font-semibold uppercase tracking-wide text-unel-humo">
                Nota interna
              </p>

              <p class="mt-1 text-sm leading-relaxed text-unel-carbon">
                <%= internal_notes.presence || "Sin nota interna." %>
              </p>
            </div>
          </div>
        </div>

        <div class="rounded-3xl border border-unel-crema-2 bg-white p-5 shadow-sm sm:p-6">
          <p class="text-sm font-semibold uppercase tracking-wide text-unel-dorado">
            Acciones
          </p>

          <div class="mt-4 grid gap-2">
            <button
              type="button"
              <%= "disabled" if primary_action_disabled %>
              class="inline-flex justify-center rounded-xl px-4 py-2 text-sm font-semibold transition <%= primary_action_disabled ? "cursor-not-allowed bg-unel-crema text-unel-humo" : "bg-unel-verde text-white hover:bg-unel-carbon" %>"
            >
              <%= primary_action_label %>
            </button>

            <% if show_payment_action %>
                <button
                    type="button"
                    class="inline-flex justify-center rounded-xl border border-unel-crema-2 bg-white px-4 py-2 text-sm font-semibold text-unel-humo transition hover:border-unel-dorado hover:text-unel-dorado"
                >
                    <%= payment_action_label %>
                </button>
            <% end %>

            <button
              type="button"
              class="inline-flex justify-center rounded-xl border border-unel-crema-2 bg-white px-4 py-2 text-sm font-semibold text-unel-humo transition hover:border-unel-dorado hover:text-unel-dorado"
            >
              Agregar nota
            </button>
          </div>
        </div>
      </aside>
    </div>
  </section>
<% else %>
  <section>
    <div class="mb-8">
      <%= link_to "← Volver a ventas", orders_back_path,
        class: "mb-4 inline-flex text-sm font-semibold text-unel-dorado transition hover:text-unel-carbon" %>

      <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-unel-dorado">
        Gestión de venta
      </p>

      <h1 class="text-2xl font-bold text-unel-carbon md:text-3xl">
        Venta no encontrada
      </h1>

      <p class="mt-2 max-w-2xl text-sm text-unel-humo">
        No encontramos información para esta venta. Vuelve a la bandeja para revisar las ventas disponibles.
      </p>
    </div>

    <div class="rounded-3xl border border-unel-crema-2 bg-white px-5 py-12 text-center shadow-sm sm:px-6">
      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-unel-crema text-lg font-bold text-unel-verde">
        V
      </div>

      <p class="mt-4 text-lg font-bold text-unel-carbon">
        No hay datos para mostrar
      </p>

      <p class="mx-auto mt-2 max-w-md text-sm text-unel-humo">
        Revisa que la venta exista o vuelve al listado para seleccionar otra.
      </p>

      <%= link_to "Volver a ventas", orders_back_path,
        class: "mt-6 inline-flex justify-center rounded-xl bg-unel-verde px-4 py-2 text-sm font-semibold text-white transition hover:bg-unel-carbon" %>
    </div>
  </section>
<% end %>