<% content_for :admin_section_key, "finances" %>
<% content_for :admin_section_inner, "Movimientos" %>
<% content_for :admin_search_placeholder, "Buscar movimientos financieros..." %>
<% content_for :admin_search_path, admin_financial_movements_path %>

<% finance_preview = Rails.env.development? && params[:preview].present? %>
<% preview_mode = params[:preview].to_s %>
<% negative_preview = finance_preview && preview_mode == "negative" %>
<% balanced_preview = finance_preview && preview_mode == "balanced" %>
<% positive_preview = finance_preview && %w[1 positive true].include?(preview_mode) %>
<% finances_back_path = finance_preview ? admin_finances_path(preview: preview_mode) : admin_finances_path %>

<% current_period = Date.current.strftime("%m/%Y") %>

<% financial_movements = if positive_preview
  [
    {
      date: Date.current.beginning_of_month + 1.day,
      movement_type: "income",
      category: "ventas",
      description: "Venta pedido mayorista",
      payment_method: "transferencia",
      amount: 350_000
    },
    {
      date: Date.current.beginning_of_month + 3.days,
      movement_type: "expense",
      category: "insumos",
      description: "Compra de frascos",
      payment_method: "transferencia",
      amount: 180_000
    },
    {
      date: Date.current.beginning_of_month + 6.days,
      movement_type: "income",
      category: "ventas",
      description: "Pago transferencia cliente",
      payment_method: "transferencia",
      amount: 245_000
    },
    {
      date: Date.current.beginning_of_month + 8.days,
      movement_type: "expense",
      category: "producción",
      description: "Compra de ingredientes",
      payment_method: "débito",
      amount: 95_000
    },
    {
      date: Date.current.beginning_of_month + 12.days,
      movement_type: "income",
      category: "ventas online",
      description: "Ventas por catálogo público",
      payment_method: "webpay",
      amount: 520_000
    },
    {
      date: Date.current.beginning_of_month + 15.days,
      movement_type: "expense",
      category: "insumos",
      description: "Compra de etiquetas",
      payment_method: "transferencia",
      amount: 210_000
    },
    {
      date: Date.current.beginning_of_month + 18.days,
      movement_type: "income",
      category: "feria",
      description: "Ventas feria local",
      payment_method: "efectivo",
      amount: 370_000
    },
    {
      date: Date.current.beginning_of_month + 21.days,
      movement_type: "expense",
      category: "operación",
      description: "Costos de producción mensual",
      payment_method: "transferencia",
      amount: 435_000
    }
  ]
elsif negative_preview
  [
    {
      date: Date.current.beginning_of_month + 1.day,
      movement_type: "income",
      category: "ventas",
      description: "Venta frascos surtidos",
      payment_method: "transferencia",
      amount: 220_000
    },
    {
      date: Date.current.beginning_of_month + 3.days,
      movement_type: "expense",
      category: "materia prima",
      description: "Compra de pescado",
      payment_method: "transferencia",
      amount: 410_000
    },
    {
      date: Date.current.beginning_of_month + 5.days,
      movement_type: "expense",
      category: "operación",
      description: "Pago electricidad",
      payment_method: "transferencia",
      amount: 185_000
    },
    {
      date: Date.current.beginning_of_month + 8.days,
      movement_type: "income",
      category: "ventas",
      description: "Venta feria local",
      payment_method: "efectivo",
      amount: 160_000
    },
    {
      date: Date.current.beginning_of_month + 11.days,
      movement_type: "expense",
      category: "insumos",
      description: "Compra de tapas y etiquetas",
      payment_method: "transferencia",
      amount: 265_000
    },
    {
      date: Date.current.beginning_of_month + 14.days,
      movement_type: "income",
      category: "ventas",
      description: "Pedido cliente frecuente",
      payment_method: "transferencia",
      amount: 400_000
    },
    {
      date: Date.current.beginning_of_month + 18.days,
      movement_type: "expense",
      category: "operación",
      description: "Arriendo y gastos operativos",
      payment_method: "transferencia",
      amount: 380_000
    }
  ]
elsif balanced_preview
  [
    {
      date: Date.current.beginning_of_month + 2.days,
      movement_type: "income",
      category: "ventas",
      description: "Venta pedido especial",
      payment_method: "transferencia",
      amount: 500_000
    },
    {
      date: Date.current.beginning_of_month + 5.days,
      movement_type: "expense",
      category: "producción",
      description: "Compra de ingredientes",
      payment_method: "transferencia",
      amount: 420_000
    },
    {
      date: Date.current.beginning_of_month + 10.days,
      movement_type: "income",
      category: "ventas",
      description: "Pago cliente frecuente",
      payment_method: "transferencia",
      amount: 500_000
    },
    {
      date: Date.current.beginning_of_month + 16.days,
      movement_type: "expense",
      category: "operación",
      description: "Pago de operación mensual",
      payment_method: "transferencia",
      amount: 580_000
    }
  ]
else
  (@financial_movements || []).to_a
end %>

<% movement_attribute = lambda do |movement, attribute, default = nil|
  if movement.respond_to?(attribute)
    movement.public_send(attribute)
  elsif movement.respond_to?(:[])
    movement[attribute] || movement[attribute.to_s] || default
  else
    default
  end
end %>

<% movement_amount = lambda do |movement|
  movement_attribute.call(movement, :amount, 0).to_f
end %>

<% movement_type = lambda do |movement|
  movement_attribute.call(movement, :movement_type, "income").to_s
end %>

<% movement_date = lambda do |movement|
  movement_attribute.call(movement, :date, nil)
end %>

<% current_month_movements = financial_movements.select do |movement|
  date = movement_date.call(movement)

  if date.present? && date.respond_to?(:to_date)
    date.to_date.month == Date.current.month && date.to_date.year == Date.current.year
  else
    true
  end
end %>

<% monthly_income = current_month_movements.select { |movement| movement_type.call(movement) == "income" }.sum { |movement| movement_amount.call(movement) } %>
<% monthly_expenses = current_month_movements.select { |movement| movement_type.call(movement) == "expense" }.sum { |movement| movement_amount.call(movement) } %>
<% monthly_balance = monthly_income - monthly_expenses %>
<% total_movements = current_month_movements.count %>

<section>
  <div class="mb-8 flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
    <div>
      <div class="mb-3">
        <%= link_to "← Ir al resumen", finances_back_path,
          class: "text-sm font-semibold text-unel-humo transition hover:text-unel-dorado" %>
      </div>

      <h1 class="text-2xl font-bold text-unel-carbon md:text-3xl">
        Movimientos financieros
      </h1>

      <p class="mt-2 max-w-2xl text-sm text-unel-humo">
        Revisa ingresos y gastos del negocio para controlar el flujo de caja mensual.
      </p>
    </div>

    <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
      <%= link_to "Registrar ingreso", new_admin_financial_movement_path(movement_type: "income"),
        class: "inline-flex w-full justify-center rounded-xl bg-unel-verde px-4 py-2 text-sm font-semibold text-white transition hover:bg-unel-carbon sm:w-auto" %>

      <%= link_to "Registrar gasto", new_admin_financial_movement_path(movement_type: "expense"),
        class: "inline-flex w-full justify-center rounded-xl border border-red-200 bg-red-50 px-4 py-2 text-sm font-semibold text-red-700 transition hover:border-red-300 hover:bg-white sm:w-auto" %>
    </div>
  </div>

  <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <div class="rounded-lg border border-unel-crema-2 bg-white p-6 shadow-sm">
      <p class="text-sm font-medium text-unel-humo">
        Ingresos del mes
      </p>

      <p class="mt-2 text-3xl font-bold text-unel-verde">
        <%= number_to_currency(monthly_income, unit: "$", precision: 0, delimiter: ".") %>
      </p>

      <p class="mt-2 text-xs text-unel-humo">
        Entradas registradas en <%= current_period %>.
      </p>
    </div>

    <div class="rounded-lg border border-unel-crema-2 bg-white p-6 shadow-sm">
      <p class="text-sm font-medium text-unel-humo">
        Gastos del mes
      </p>

      <p class="mt-2 text-3xl font-bold text-red-600">
        <%= number_to_currency(monthly_expenses, unit: "$", precision: 0, delimiter: ".") %>
      </p>

      <p class="mt-2 text-xs text-unel-humo">
        Salidas registradas en <%= current_period %>.
      </p>
    </div>

    <div class="rounded-lg border border-unel-crema-2 bg-white p-6 shadow-sm">
      <p class="text-sm font-medium text-unel-humo">
        Balance
      </p>

      <p class="mt-2 text-3xl font-bold <%= monthly_balance.negative? ? "text-red-600" : "text-unel-carbon" %>">
        <%= number_to_currency(monthly_balance, unit: "$", precision: 0, delimiter: ".") %>
      </p>

      <p class="mt-2 text-xs text-unel-humo">
        Ingresos menos gastos.
      </p>
    </div>

    <div class="rounded-lg border border-unel-crema-2 bg-white p-6 shadow-sm">
      <p class="text-sm font-medium text-unel-humo">
        Movimientos
      </p>

      <p class="mt-2 text-3xl font-bold text-unel-dorado">
        <%= total_movements %>
      </p>

      <p class="mt-2 text-xs text-unel-humo">
        Registros del periodo actual.
      </p>
    </div>
  </div>

  <div
    <% if financial_movements.any? %>
      data-controller="table-filter table-sort"
      data-table-filter-singular-value="movimiento"
      data-table-filter-plural-value="movimientos"
    <% end %>
    class="mt-6 rounded-2xl border border-unel-crema-2 bg-white shadow-sm"
  >
    <div class="flex flex-col gap-3 border-b border-unel-crema-2 px-4 py-5 sm:px-6 lg:flex-row lg:items-center lg:justify-between">
      <div>
        <h2 class="text-lg font-bold text-unel-carbon">
          Registro de movimientos
        </h2>

        <p class="mt-1 text-sm text-unel-humo">
          Lista de ingresos y gastos con fecha, categoría, descripción y monto.
        </p>
      </div>

      <% if financial_movements.any? %>
        <div class="grid w-full gap-3 lg:flex lg:w-auto lg:items-center">
          <span data-table-filter-target="resultsCount" class="text-xs text-unel-humo">
          </span>

          <div class="flex w-full min-w-0 items-center gap-2 rounded-xl border border-unel-crema-2 px-4 py-2 lg:w-52">
            <label for="financial_movements_sort" class="shrink-0 text-xs font-semibold text-unel-humo">
              Ordenar:
            </label>

            <select
              id="financial_movements_sort"
              data-table-sort-target="select"
              data-action="change->table-sort#sort"
              class="min-w-0 flex-1 bg-transparent text-sm font-semibold text-unel-verde outline-none"
            >
              <option value="">Orden original</option>
              <option value="date_desc">Fecha reciente</option>
              <option value="date_asc">Fecha antigua</option>
              <option value="amount_desc">Monto mayor</option>
              <option value="amount_asc">Monto menor</option>
            </select>
          </div>

          <div class="w-full rounded-xl bg-unel-crema px-4 py-2 lg:w-64">
            <input
              type="search"
              placeholder="Buscar movimiento..."
              data-table-filter-target="input"
              data-action="input->table-filter#filter"
              class="w-full bg-transparent text-sm text-unel-negro outline-none placeholder:text-unel-humo"
            >
          </div>
        </div>
      <% end %>
    </div>

    <% if financial_movements.any? %>
      <div data-controller="table-overflow" class="unel-table-scroll-wrapper">
        <div data-table-overflow-target="hint" class="unel-scroll-hint">
          Desliza para ver toda la tabla →
        </div>

        <div
          data-table-overflow-target="scroll"
          data-action="scroll->table-overflow#check"
          class="overflow-x-auto"
        >
          <table class="min-w-220 w-full text-left text-sm">
            <thead class="bg-unel-verde text-xs uppercase tracking-wide text-unel-blanco">
              <tr>
                <th class="px-6 py-4 font-semibold">Fecha</th>
                <th class="px-6 py-4 font-semibold">Tipo</th>
                <th class="px-6 py-4 font-semibold">Categoría</th>
                <th class="px-6 py-4 font-semibold">Descripción</th>
                <th class="px-6 py-4 font-semibold">Método</th>
                <th class="px-6 py-4 text-right font-semibold">Monto</th>
                <th class="px-6 py-4 text-right font-semibold">Acciones</th>
              </tr>
            </thead>

            <tbody data-table-sort-target="body" class="divide-y divide-unel-crema-2">
              <% financial_movements.each_with_index do |movement, index| %>
                <% type = movement_type.call(movement) %>
                <% amount = movement_amount.call(movement) %>
                <% date = movement_date.call(movement) %>
                <% category = movement_attribute.call(movement, :category, "Sin categoría") %>
                <% description = movement_attribute.call(movement, :description, "Sin descripción") %>
                <% payment_method = movement_attribute.call(movement, :payment_method, "Sin método") %>
                <% movement_id = movement_attribute.call(movement, :id, index + 1) %>
                <% movement_edit_path = finance_preview ? edit_admin_financial_movement_path(movement_id, movement_type: type, preview: preview_mode) : edit_admin_financial_movement_path(movement_id, movement_type: type) %>

                <% formatted_date = if date.present? && date.respond_to?(:strftime)
                  date.strftime("%d/%m/%Y")
                elsif date.present?
                  date.to_s
                else
                  "Sin fecha"
                end %>

                <% type_label = type == "expense" ? "Gasto" : "Ingreso" %>
                <% type_classes = type == "expense" ? "border-red-200 bg-red-50 text-red-700" : "border-unel-crema-2 bg-white text-unel-verde" %>
                <% amount_classes = type == "expense" ? "text-red-600" : "text-unel-verde" %>
                <% amount_prefix = type == "expense" ? "−" : "+" %>

                <tr
                  data-table-filter-target="row"
                  data-table-sort-target="row"
                  data-search-text="<%= [formatted_date, type_label, category, description, payment_method, amount].join(' ') %>"
                  data-sort-date="<%= date.respond_to?(:to_date) ? date.to_date.strftime('%Y%m%d') : "" %>"
                  data-sort-amount="<%= amount %>"
                  class="transition hover:bg-unel-crema/50"
                >
                  <td class="px-6 py-4 font-semibold text-unel-carbon">
                    <%= formatted_date %>
                  </td>

                  <td class="px-6 py-4">
                    <span class="inline-flex rounded-full border px-3 py-1 text-xs font-semibold <%= type_classes %>">
                      <%= type_label %>
                    </span>
                  </td>

                  <td class="px-6 py-4 text-unel-humo">
                    <%= category.to_s.humanize %>
                  </td>

                  <td class="px-6 py-4 text-unel-humo">
                    <%= description.presence || "Sin descripción" %>
                  </td>

                  <td class="px-6 py-4 text-unel-humo">
                    <%= payment_method.to_s.humanize %>
                  </td>

                  <td class="px-6 py-4 text-right font-bold <%= amount_classes %>">
                    <%= amount_prefix %><%= number_to_currency(amount.abs, unit: "$", precision: 0, delimiter: ".") %>
                  </td>

                  <td class="px-6 py-4">
                    <div class="flex items-center justify-end gap-3">
                      <%= link_to "Editar", movement_edit_path,
                        class: "text-sm font-semibold text-unel-humo transition hover:text-unel-dorado" %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <div data-table-filter-target="emptyState" class="hidden border-t border-unel-crema-2 px-4 py-12 text-center sm:px-6">
        <p class="text-lg font-bold text-unel-negro">
          No encontramos movimientos con esa búsqueda
        </p>

        <p class="mx-auto mt-2 max-w-md text-sm text-unel-humo">
          Intenta buscar por fecha, tipo, categoría, descripción, método o monto.
        </p>

        <button
          type="button"
          data-action="table-filter#clear"
          class="mt-6 rounded-xl border border-unel-crema-2 px-4 py-2 text-sm font-semibold text-unel-humo transition hover:border-unel-dorado hover:text-unel-dorado"
        >
          Limpiar búsqueda
        </button>
      </div>
    <% else %>
      <div class="px-4 py-12 text-center sm:px-6">
        <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-unel-crema text-lg font-bold text-unel-verde">
          $
        </div>

        <p class="mt-3 text-lg font-bold text-unel-carbon">
          Todavía no hay movimientos financieros registrados
        </p>

        <p class="mx-auto mt-2 max-w-md text-sm text-unel-humo">
          Registra ingresos o gastos para comenzar a controlar el flujo de caja del negocio.
        </p>

        <div class="mt-6 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-center">
          <%= link_to "Registrar ingreso", new_admin_financial_movement_path(movement_type: "income"),
            class: "inline-flex w-full justify-center rounded-xl bg-unel-verde px-4 py-2 text-sm font-semibold text-white transition hover:bg-unel-carbon sm:w-auto" %>

          <%= link_to "Registrar gasto", new_admin_financial_movement_path(movement_type: "expense"),
            class: "inline-flex w-full justify-center rounded-xl border border-red-200 bg-red-50 px-4 py-2 text-sm font-semibold text-red-700 transition hover:border-red-300 hover:bg-white sm:w-auto" %>
        </div>
      </div>
    <% end %>
  </div>
</section>