<!DOCTYPE html>
<html>
  <head>
    <title>Unel - Panel de Administración</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>

    <%= stylesheet_link_tag "actiontext", "data-turbo-track": "reload" %>
  </head>

  <body class="h-screen overflow-hidden bg-unel-blanco text-unel-negro">
    <div data-controller="admin-sidebar" class="flex h-screen overflow-hidden">
      <%= render "admin/shared/sidebar" %>

      <div class="flex h-screen min-w-0 flex-1 flex-col overflow-hidden">
        <%= render "admin/shared/topbar" %>

        <main class="min-h-0 flex-1 overflow-y-auto p-8">
          <%= render "admin/shared/flash" %>
          <%= yield %>
        </main>
      </div>
    </div>
  </body>
</html>